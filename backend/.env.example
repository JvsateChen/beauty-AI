# ============================================================================
# 采选美妆 AI · 后端环境变量样例
# 用法：cp .env.example .env  然后按需填写。留空的项 = 该能力「未接入」，
#       服务照常启动，接口会如实标注为「未接入」，不会伪造数据。
# ============================================================================

# ---------------------------------------------------------------- 基础
APP_NAME=采选美妆 AI
APP_VERSION=3.0.0
# dev | staging | prod（prod 会关闭 /docs 并强制校验 CORS 白名单）
ENV=dev
DEBUG=false
LOG_LEVEL=INFO
# 生产建议 true：输出单行 JSON 结构化日志，便于采集
LOG_JSON=false

# ---------------------------------------------------------------- 服务
HOST=0.0.0.0
PORT=8000
# 允许跨域的来源白名单（逗号分隔）。生产**必须**显式列出域名，禁止 *
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ---------------------------------------------------------------- 存储
# 留空 = 使用 SQLite（开发默认，文件路径见 SQLITE_PATH）
SQLITE_PATH=data/caixuan.db
# 生产填 Postgres，例如：
# DATABASE_URL=postgresql+psycopg://caixuan:password@db:5432/caixuan
DATABASE_URL=
DB_ECHO=false

# ---------------------------------------------------------------- 鉴权
# 留空时自动生成运行时密钥（仅 dev 可接受；生产必须显式设置随机长串）
SESSION_SECRET=
SESSION_TTL_SECONDS=2592000
# true = 允许匿名设备会话（一期 H5 无需注册即可用只读能力 + 订阅）
ALLOW_ANONYMOUS_SESSION=true

# ---------------------------------------------------------------- 数据源
# seed   = 只用内置演示数据集（默认，让功能链路完整可验证）
# live   = 只用真实渠道；未配置凭据的渠道显示为「未接入」
# hybrid = 真实渠道优先，缺失渠道用演示数据集补齐（逐条标注来源）★上线后推荐
DATA_MODE=seed
PRICE_CACHE_TTL_SECONDS=300
OUTBOUND_TIMEOUT_SECONDS=8
OUTBOUND_MAX_RETRIES=2
DATA_SOURCE_LABEL=公开渠道行情聚合

# ---------------------------------------------------------------- 渠道联盟凭据
# 每填齐一组即多接入一个渠道；全部留空 = 5 个渠道均为「未接入」
# 淘宝联盟（天猫）
TMALL_UNION_APP_KEY=
TMALL_UNION_APP_SECRET=
TMALL_UNION_PID=
# 京东联盟
JD_UNION_APP_KEY=
JD_UNION_APP_SECRET=
JD_UNION_PID=
# 拼多多多多客
PDD_DUO_APP_KEY=
PDD_DUO_APP_SECRET=
PDD_DUO_PID=
# 唯品会联盟
VIP_UNION_APP_KEY=
VIP_UNION_APP_SECRET=
VIP_UNION_PID=
# 保税仓 / 跨境供应链数据方（通用 JSON 接口）
BONDED_API_BASE=
BONDED_API_KEY=

# ---------------------------------------------------------------- 推送（M4）
# 只有凭据齐全且 PUSH_ENABLED=true 时才会真正发送；否则如实回报「推送通道未接入」
PUSH_ENABLED=false
PUSH_INTERVAL_MINUTES=30
# 同一订阅的推送冷却（小时），防止价格抖动时反复打扰
PUSH_COOLDOWN_HOURS=12
POLL_ENABLED=true

# 公众号模板消息
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_TEMPLATE_ID=
# 小程序订阅消息
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_MINI_TEMPLATE_ID=

# 微信模板字段映射（JSON）。各账号模板字段编号不同，按自己申请的模板填。
# 默认映射：thing1=商品 / amount2=现价 / amount3=目标价 / date4=时间 / thing5=渠道
# 注意微信类型约束：thing ≤ 20 字符、amount 为数字、date 为 "YYYY-MM-DD HH:MM"
WECHAT_TEMPLATE_FIELDS=

# ---------------------------------------------------------------- 合规口径
# 临期阈值（月）：剩余保质期 ≤ 该值自动打「临期预警」标签
NEAR_EXPIRY_MONTHS=6
