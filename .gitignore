# 根目录忽略规则（子目录另有各自的 .gitignore）
# 环境变量与凭据：绝不入库
.env
.env.*
!.env.example

# 依赖与构建产物
node_modules/
.next/
out/
dist/
build/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# TS 增量编译缓存（会写出本机绝对路径）
*.tsbuildinfo

# 本地数据库与日志
*.db
*.db-wal
*.db-shm
data/
*.log
logs/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
